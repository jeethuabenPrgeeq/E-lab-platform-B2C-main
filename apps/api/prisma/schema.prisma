generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum ProblemDifficulty {
  Easy
  Medium
  Hard
}

enum WorkspaceType {
  code
  web
  framework
  database
  devops
}

enum ProblemSource {
  practice
  stack
  challenge
}

enum UserRole {
  LEARNER
  PLATFORM_ADMIN
  SUPER_ADMIN
  INSTITUTE_ADMIN
}

enum OrganizationType {
  university
  college
  corporate
  skill_academy
  bootcamp
  ngo
  government
}

enum ContentBatchType {
  regular_practice
  stack_section
  real_time_challenge
}

enum OrganizationStatus {
  active
  suspended
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PracticeUploadMethod {
  manual
  csv
  ai
}

enum TechnologyCategory {
  language
  framework
  database
  devops
  tool
}

enum TechnologyStatus {
  active
  draft
  disabled
}

enum ProblemStatus {
  draft
  review
  ready
  published
  deprecated
}

enum SourceCheckKind {
  required
  forbidden
}

enum PlanId {
  starter
  professional
  premium
  enterprise
}

enum BillingCycle {
  monthly
  quarterly
  annual
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
}

enum PaymentMethod {
  upi
  card
  netbanking
  invoice
}

enum PaymentStatus {
  succeeded
  failed
  refunded
  partially_refunded
}

enum RefundRequestStatus {
  pending
  approved
  rejected
}

enum DiscountKind {
  percent
  fixed
}

enum CouponDuration {
  once
  repeating
  forever
}

enum TicketStatus {
  new
  open
  pending
  resolved
}

enum TicketPriority {
  urgent
  high
  normal
  low
}

enum TicketCategory {
  billing
  refund
  plan
  account
  certificate
  institution
  technical
  other
}

enum TicketSource {
  customer
  platform_admin
}

enum TicketMessageKind {
  requester
  agent
  note
  event
}

enum ReportFrequency {
  weekly
  monthly
}

enum ReportRunStatus {
  ready
  failed
}

enum AudienceKind {
  all
  paid
  free
  trial
  plan
  inactive
  institution
  instructors
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
}

enum DraftStatus {
  draft
  validation_pending
  validation_failed
  validated
  ready_to_publish
  published
  unpublished
  archived
}

enum AccessTier {
  free
  starter
  professional
  premium
}

enum CatalogVisibility {
  listed
  hidden
  retired
}

enum PathLevel {
  beginner
  intermediate
  advanced
}

enum PathStatus {
  draft
  published
  archived
}

enum ChallengeKind {
  weekly
  monthly
  hiring
  sponsored
}

enum ChallengeAccess {
  everyone
  paid
}

enum RunKind {
  run
  submit
}

enum RunState {
  queued
  running
  done
  failed
  cancelled
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  mustChangePassword Boolean @default(false)
  name         String
  role         UserRole   @default(LEARNER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  sessions       RefreshSession[]
  practiceBatches PracticeDraftBatch[]

  adminRoleId   String?
  adminRole     AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  adminScope    String     @default("All institutions")
  mfaEnabled    Boolean    @default(false)
  invitedByName String?
  revokeReason  String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  learnerGroupId String?
  learnerGroup   LearnerGroup? @relation(fields: [learnerGroupId], references: [id], onDelete: SetNull)

  staffTitle       String?
  staffPermissions String[]       @default([])
  staffGroups      LearnerGroup[] @relation("StaffGroups")

  problemsCreated   Problem[]          @relation("ProblemCreatedBy")
  problemsUpdated   Problem[]          @relation("ProblemUpdatedBy")
  problemsPublished Problem[]          @relation("ProblemPublishedBy")
  problemsAssigned  Problem[]          @relation("ProblemAssignee")
  contentBatches    ContentBatch[]
  problemVersions   ProblemVersion[]
  auditLogs         TechnicalAuditLog[]

  pathsCreated      LearningPath[]
  challengesCreated Challenge[]

  subscriptions     Subscription[]
  payments          Payment[]
  couponRedemptions CouponRedemption[]

  ticketsRequested  SupportTicket[]    @relation("TicketRequester")
  ticketsAssigned   SupportTicket[]    @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  reportRuns        ReportRun[]
  reportSchedules   ReportSchedule[]
  notifications     UserNotification[]
  codeRuns          CodeRun[]
  rejudgeJobs       RejudgeJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  code          String             @unique
  type          OrganizationType
  status        OrganizationStatus @default(active)
  contactEmail  String?
  permissions   Json               @default("[]")
  createdByName String?

  users          User[]
  problems       Problem[]
  contentBatches ContentBatch[]
  learnerGroups  LearnerGroup[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model LearnerGroup {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  learners       User[]
  staff          User[]         @relation("StaffGroups")
  batches        ContentBatch[]
  createdAt      DateTime       @default(now())

  @@unique([organizationId, name])
  @@map("learner_groups")
}

model ContentBatch {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String           @default("")
  type           ContentBatchType @default(regular_practice)
  focus          String           @default("")
  easyTarget     Int              @default(0)
  mediumTarget   Int              @default(0)
  hardTarget     Int              @default(0)
  assignedAt     DateTime?
  assignedByName String?
  assignedGroupId String?
  assignedGroup  LearnerGroup?    @relation(fields: [assignedGroupId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          ContentBatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("content_batches")
}

model ContentBatchItem {
  id        String       @id @default(cuid())
  batchId   String
  batch     ContentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([batchId, problemId])
  @@index([batchId, position])
  @@index([problemId])
  @@map("content_batch_items")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_sessions")
}

model PracticeDraftBatch {
  id          String               @id @default(cuid())
  technology  String
  method      PracticeUploadMethod
  source      String?
  savedCount  Int
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  drafts      PracticeDraft[]
  createdAt   DateTime             @default(now())

  @@index([createdById])
  @@map("practice_draft_batches")
}

model PracticeDraft {
  id         String             @id @default(cuid())
  batchId    String
  batch      PracticeDraftBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber  Int
  problemId  String
  shortName  String
  title      String
  difficulty String
  values     Json
  issues     Json
  status     DraftStatus        @default(draft)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([batchId])
  @@index([problemId])
  @@index([shortName])
  @@map("practice_drafts")
}

model Technology {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String

  category      TechnologyCategory @default(language)
  status        TechnologyStatus   @default(active)
  runtimeImage  String             @default("")
  version       String             @default("")
  fileExtension String             @default("")
  judgeLanguage String?

  problems Problem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("technologies")
}

model Problem {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id])

  difficulty    ProblemDifficulty
  workspaceType WorkspaceType
  source        ProblemSource     @default(practice)

  shortDescription String
  problemStatement String

  inputFormat  String?
  outputFormat String?
  constraints  Json?
  notes        Json?

  skills           Json
  estimatedMinutes Int

  defaultLanguage  String
  allowedLanguages Json

  starterCode  String?
  starterFiles Json?
  sampleTests  Json?

  domainSlug String?
  stackSlug  String?
  moduleSlug String?

  status            ProblemStatus @default(draft)
  version           Int           @default(1)
  reviewNote        String?
  referenceSolution String?

  createdById   String?
  createdBy     User?     @relation("ProblemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?     @relation("ProblemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedById String?
  publishedBy   User?     @relation("ProblemPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      User?     @relation("ProblemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  publishedAt   DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  tier             AccessTier        @default(free)
  visibility       CatalogVisibility @default(listed)
  visibilityReason String?
  featured         Boolean           @default(false)

  testCases      TestCase[]
  sourceChecks   SourceCheck[]
  versions       ProblemVersion[]
  pathSteps      LearningPathStep[]
  challengeItems ChallengeProblem[]
  batchItems     ContentBatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility])
  @@index([status])
  @@index([technologyId])
  @@index([assigneeId])
  @@index([organizationId])
  @@map("problems")
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  input          String?
  expectedOutput String
  hidden         Boolean @default(true)

  position  Int     @default(0)
  score     Int     @default(1)
  timeoutMs Int?
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([problemId, position])
  @@map("test_cases")
}

model SourceCheck {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  kind     SourceCheckKind
  filePath String
  pattern  String
  isRegex  Boolean         @default(false)
  message  String
  enabled  Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([problemId])
  @@map("source_checks")
}

model ProblemVersion {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  version     Int
  reason      String
  snapshot    Json
  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([problemId, version])
  @@map("problem_versions")
}

model TechnicalAuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String

  action     String
  entityType String
  entityId   String
  summary    String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  outcome    String  @default("success")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("technical_audit_logs")
}

model Domain {
  id              String @id @default(cuid())
  slug            String @unique
  name            String
  description     String
  pathDescription String

  stacks Stack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("domains")
}

model Stack {
  id       String @id @default(cuid())
  slug     String @unique
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id])

  name        String
  shortName   String
  description String
  technologies Json
  level       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stacks")
}

model LearningPath {
  id          String     @id @default(cuid())
  title       String
  summary     String     @default("")
  level       PathLevel
  tier        AccessTier @default(free)
  status      PathStatus @default(draft)
  certificate Boolean    @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  steps LearningPathStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("learning_paths")
}

model LearningPathStep {
  id        String       @id @default(cuid())
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  position  Int

  @@unique([pathId, problemId])
  @@index([pathId, position])
  @@map("learning_path_steps")
}

model Challenge {
  id           String          @id @default(cuid())
  title        String
  kind         ChallengeKind
  sponsor      String?
  startAt      DateTime
  endAt        DateTime
  prize        Int             @default(0)
  access       ChallengeAccess @default(everyone)
  published    Boolean         @default(false)
  cancelled    Boolean         @default(false)
  cancelReason String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  problems ChallengeProblem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@map("challenges")
}

model ChallengeProblem {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  position    Int

  @@unique([challengeId, problemId])
  @@index([challengeId, position])
  @@map("challenge_problems")
}

model PlanPrice {
  plan      PlanId
  cycle     BillingCycle
  amount    Int
  updatedAt DateTime     @updatedAt

  @@id([plan, cycle])
  @@map("plan_prices")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              PlanId
  cycle             BillingCycle
  amount            Int
  status            SubscriptionStatus @default(active)
  cancelAtPeriodEnd Boolean            @default(false)
  pendingPlan       PlanId?
  pendingCycle      BillingCycle?
  pendingAmount     Int?
  institution       String?
  seats             Int?
  method            PaymentMethod
  methodLabel       String
  couponCode        String?
  startedAt         DateTime           @default(now())
  periodEnd         DateTime
  cancelledAt       DateTime?
  cancelReason      String?

  payments    Payment[]
  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String               @id @default(cuid())
  subscriptionId    String
  subscription      Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              PlanId
  cycle             BillingCycle
  listAmount        Int
  discount          Int                  @default(0)
  couponCode        String?
  amount            Int
  status            PaymentStatus
  refunded          Int                  @default(0)
  attempts          Json                 @default("[]")
  refundStatus      RefundRequestStatus?
  refundReason      String?
  refundRequestedAt DateTime?
  refundNote        String?
  method            PaymentMethod
  methodLabel       String
  paidAt            DateTime             @default(now())
  invoiceSeq        Int                  @unique @default(autoincrement())
  invoiceIssuedAt   DateTime?
  taxRate           Int?
  taxInclusive      Boolean?
  sellerGstin       String?
  invoicePrefix     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model Coupon {
  code           String         @id
  description    String         @default("")
  kind           DiscountKind
  value          Int
  plans          Json           @default("[]")
  cycles         Json           @default("[]")
  duration       CouponDuration @default(once)
  months         Int            @default(1)
  maxRedemptions Int?
  firstTimeOnly  Boolean        @default(false)
  startsAt       DateTime
  endsAt         DateTime?
  paused         Boolean        @default(false)
  endedEarly     Boolean        @default(false)

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model CouponRedemption {
  id             String        @id @default(cuid())
  couponCode     String
  coupon         Coupon        @relation(fields: [couponCode], references: [code], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan           PlanId
  cycle          BillingCycle
  saved          Int
  revenue        Int
  at             DateTime      @default(now())

  @@index([couponCode, at])
  @@map("coupon_redemptions")
}

model SupportTicket {
  id              String         @id @default(cuid())
  number          Int            @unique @default(autoincrement())
  subject         String
  requesterId     String?
  requester       User?          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName   String
  requesterEmail  String
  requesterRole   String
  requesterOrg    String         @default("")
  category        TicketCategory
  priority        TicketPriority @default(normal)
  status          TicketStatus   @default(new)
  source          TicketSource   @default(customer)
  assigneeId      String?
  assignee        User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  rating          Int?

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String            @id @default(cuid())
  ticketId   String
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind       TicketMessageKind
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  at         DateTime          @default(now())

  @@index([ticketId, at])
  @@map("ticket_messages")
}

model ReportRun {
  id              String          @id @default(cuid())
  templateId      String
  range           String?
  from            DateTime
  to              DateTime
  requestedById   String?
  requestedBy     User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByName String
  status          ReportRunStatus
  rows            Int             @default(0)
  note            String?
  scheduleId      String?
  at              DateTime        @default(now())

  @@index([at])
  @@map("report_runs")
}

model ReportSchedule {
  id            String           @id @default(cuid())
  templateId    String
  frequency     ReportFrequency
  weekday       Int              @default(1)
  dayOfMonth    Int              @default(1)
  hour          Int              @default(9)
  recipients    Json             @default("[]")
  active        Boolean          @default(true)
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  lastRunAt     DateTime?
  lastStatus    ReportRunStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_schedules")
}

model PlatformSetting {
  section       String   @id
  values        Json
  updatedById   String?
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

model NotificationCampaign {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  name          String
  subject       String
  body          String
  link          String         @default("")
  channels      Json           @default("[]")
  audienceKind  AudienceKind
  audienceValue String?
  status        CampaignStatus @default(draft)
  sendAt        DateTime?
  sentAt        DateTime?
  recipients    Int            @default(0)
  delivered     Int            @default(0)
  opened        Int            @default(0)
  clicked       Int            @default(0)
  cancelReason  String?
  createdById   String?
  createdByName String

  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAt])
  @@map("notification_campaigns")
}

model UserNotification {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, createdAt])
  @@map("user_notifications")
}

model NotificationAutomation {
  id            String   @id
  enabled       Boolean
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@map("notification_automations")
}

model AdminRole {
  id            String  @id
  name          String
  description   String  @default("")
  system        Boolean @default(false)
  locked        Boolean @default(false)
  permissions   Json    @default("[]")
  updatedByName String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_roles")
}

model JudgeWorker {
  id              String    @id @default(cuid())
  name            String
  host            String    @unique
  capacity        Int       @default(4)
  version         String    @default("")
  status          String    @default("online")
  lastHeartbeatAt DateTime?
  lastError       String?

  runs CodeRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("judge_workers")
}

model CodeRun {
  id              String    @id @default(cuid())
  kind            RunKind
  state           RunState  @default(queued)
  priority        String    @default("normal")
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  problemSlug     String
  language        String
  workspaceType   String    @default("")
  code            String
  input           String?
  workerId        String?
  worker          JudgeWorker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  outcome         String?
  verdict         String?
  originalVerdict String?
  overrideReason  String?
  testsPassed     Int?
  testsTotal      Int?
  durationMs      Int?
  exitCode        Int?
  stdout          String?
  stderr          String?
  results         Json?
  error           String?
  rejudgeJobId    String?
  rejudgeJob      RejudgeJob?  @relation(fields: [rejudgeJobId], references: [id], onDelete: SetNull)
  rejudgeOfId     String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([kind, queuedAt])
  @@index([state])
  @@index([problemSlug, kind])
  @@index([userId, queuedAt])
  @@map("code_runs")
}

model RejudgeJob {
  id          String    @id @default(cuid())
  problemSlug String
  scope       String
  since       DateTime?
  total       Int       @default(0)
  done        Int       @default(0)
  status      String    @default("running")
  changes     Json      @default("{}")
  startedById String?
  startedBy   User?     @relation(fields: [startedById], references: [id], onDelete: SetNull)
  runs        CodeRun[]
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
  @@map("rejudge_jobs")
}

model PlagiarismFlag {
  id          String    @id @default(cuid())
  problemSlug String
  runAId      String
  runBId      String
  similarity  Float
  decision    String
  decidedBy   String
  decidedAt   DateTime  @default(now())

  @@unique([runAId, runBId])
  @@map("plagiarism_flags")
}

model RuntimeEntry {
  id        String   @id
  kind      String
  status    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@map("runtime_entries")
}

model ProblemReport {
  id             String    @id @default(cuid())
  number         Int       @unique @default(autoincrement())
  problemSlug    String
  title          String
  category       String
  status         String    @default("open")
  assigneeId     String?
  assigneeName   String?
  resolutionType String?
  resolutionNote String?
  resolvedAt     DateTime?

  entries ProblemReportEntry[]
  events  ProblemReportEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([problemSlug, category])
  @@map("problem_reports")
}

model ProblemReportEntry {
  id           String        @id @default(cuid())
  reportId     String
  report       ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId       String?
  learnerName  String
  message      String
  submissionId String?
  language     String        @default("")
  at           DateTime      @default(now())

  @@index([reportId])
  @@index([userId, at])
  @@map("problem_report_entries")
}

model ProblemReportEvent {
  id        String        @id @default(cuid())
  reportId  String
  report    ProblemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind      String
  actorName String
  text      String
  at        DateTime      @default(now())

  @@index([reportId, at])
  @@map("problem_report_events")
}

model TechTicket {
  id                String    @id @default(cuid())
  number            Int       @unique @default(autoincrement())
  subject           String
  requesterId       String?
  requesterName     String
  requesterEmail    String
  requesterRole     String
  requesterOrg      String    @default("")
  category          String
  priority          String    @default("normal")
  status            String    @default("new")
  assigneeId        String?
  assigneeName      String?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  rating            Int?
  escalatedTicketId String?

  messages TechTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@map("tech_tickets")
}

model TechTicketMessage {
  id         String     @id @default(cuid())
  ticketId   String
  ticket     TechTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind       String
  authorId   String?
  authorName String
  body       String
  at         DateTime   @default(now())

  @@index([ticketId, at])
  @@map("tech_ticket_messages")
}

model Incident {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  title         String
  severity      String
  status        String    @default("investigating")
  components    Json      @default("[]")
  commanderId   String?
  commanderName String
  links         Json      @default("[]")
  postmortem    Json?
  startedAt     DateTime  @default(now())
  resolvedAt    DateTime?

  updates IncidentUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("incidents")
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind       String
  status     String?
  message    String
  public     Boolean  @default(false)
  authorName String
  at         DateTime @default(now())

  @@index([incidentId, at])
  @@map("incident_updates")
}

model Release {
  id           String    @id @default(cuid())
  version      String    @unique
  title        String
  type         String
  status       String    @default("draft")
  ownerId      String?
  ownerName    String
  stage        Int       @default(0)
  stageMinutes Int       @default(10)
  stageAt      DateTime?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  changes      Json      @default("[]")
  checklist    Json      @default("[]")

  events ReleaseEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("releases")
}

model ReleaseEvent {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  actorName String
  text      String
  tone      String   @default("neutral")
  at        DateTime @default(now())

  @@index([releaseId, at])
  @@map("release_events")
}

