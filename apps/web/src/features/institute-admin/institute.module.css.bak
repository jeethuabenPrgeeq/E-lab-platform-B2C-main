.workspace{display:grid;grid-template-columns:220px minmax(0,1fr);gap:22px;align-items:start}.localNav,.panel,.banner,.stat,.card{background:#dfe6e9;border-radius:20px;box-shadow:6px 6px 12px #c6c9cf,-6px -6px 12px #fff}.localNav{padding:15px;display:flex;flex-direction:column;gap:5px;position:sticky;top:20px}.navTitle{font-weight:800;display:flex;align-items:center;gap:8px;padding:10px 8px 18px;flex-wrap:wrap}.navTitle small{font-size:10px;color:#47657c;letter-spacing:.07em}.navLink{display:flex;align-items:center;gap:9px;padding:11px;border-radius:12px;text-decoration:none;color:#34454d;font-size:13px}.navLink:hover,.navActive{background:#cfdce3;color:#165f9c}.workArea{min-width:0}.page{display:flex;flex-direction:column;gap:24px;color:#253640}.heading{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.heading h1{font-size:clamp(23px,2.5vw,32px);margin:6px 0}.heading p,.banner p,.help{color:#60717c;margin:0;line-height:1.5}.eyebrow{font-size:12px;color:#2870ad;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.tag{font-size:11px;color:#52718a;background:#eaf0f3;padding:8px 12px;border-radius:12px}.banner{display:flex;align-items:center;gap:18px;padding:22px}.banner h2{margin:0 0 6px;font-size:20px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.stat{padding:22px;display:flex;flex-direction:column;gap:12px}.stat span{font-size:13px;color:#60717c}.stat strong{font-size:28px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{padding:23px;display:flex;flex-direction:column;gap:14px;min-height:135px;color:#273c49;text-decoration:none}.card span{display:flex;gap:5px;align-items:center;font-size:12px;color:#226da8;margin-top:auto}.card:hover{transform:translateY(-2px)}.panel{padding:25px}.panel h2{margin:0 0 20px;font-size:19px}.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px;align-items:end}.field{display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:600;min-width:0}.field input,.field select,.search input{background:#edf2f4;border:1px solid #c5d0d6;border-radius:11px;padding:12px;color:#253640;font:inherit;min-width:0}.field input:focus,.field select:focus,.search input:focus{outline:2px solid #397bb2}.primary{border:0;border-radius:12px;background:#246fa9;color:white;font-weight:700;padding:12px 16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;max-width:260px}.primary:disabled{opacity:.45;cursor:not-allowed}.tableScroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px;text-align:left}th,td{padding:13px;border-bottom:1px solid #c8d2d7;white-space:nowrap}td button{border:1px solid #bdcbd2;border-radius:8px;padding:6px 9px;background:#edf2f4;color:#264b68;cursor:pointer}td button:disabled{opacity:.5;cursor:not-allowed}.search{display:flex;align-items:center;gap:10px;margin-bottom:15px}.search input{width:min(100%,360px)}.choice,.checkGrid{display:flex;gap:16px;flex-wrap:wrap}.choice label,.checkGrid label{display:flex;align-items:center;gap:8px;background:#eaf0f3;border-radius:12px;padding:12px;font-size:13px}.checkGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.help{font-size:13px;margin-top:14px}.notice{display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid #9bb9d0;padding:13px 17px;border-radius:12px;color:#22587d}.notice button{background:transparent;border:0;color:inherit;cursor:pointer;text-decoration:underline}.error{color:#aa3342;font-size:13px}.inlineLink{display:inline-block;color:#226da8;font-weight:600;margin:8px 0 15px}@media(max-width:1200px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace{grid-template-columns:190px minmax(0,1fr)}}@media(max-width:760px){.workspace{grid-template-columns:1fr}.localNav{position:static;display:flex;flex-direction:row;overflow-x:auto;align-items:center}.navTitle{min-width:150px;padding:8px}.navLink{white-space:nowrap}.cards,.stats,.form,.checkGrid{grid-template-columns:1fr}.panel{padding:18px}}
